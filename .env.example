# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Optional: Rate limiting (requests per IP per hour)
RATE_LIMIT_PER_HOUR=10

# Optional: Max fetch size in bytes (default: 2MB)
MAX_FETCH_SIZE=2097152

# Optional: Model configurations
# Claude model for main generation (recommended: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI model for critique/refinement
# Use gpt-4o-mini for 85% cost savings with minimal quality loss (recommended for production)
# Use gpt-4 only if you need maximum quality
OPENAI_MODEL=gpt-4o-mini

# Optional: Enable caching for repeated URLs (saves API costs)
ENABLE_CACHE=true
